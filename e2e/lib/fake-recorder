#!/usr/bin/env python3
"""Fake recorder for tests: `fake-recorder <out.wav>`; behaves per $FAKE_DIR/recorder-mode."""
import math, os, signal, struct, sys, time

out = sys.argv[1]
fd = os.environ["FAKE_DIR"]
mode_file = os.path.join(fd, "recorder-mode")
mode = open(mode_file).read().strip() if os.path.exists(mode_file) else "ok"

def log(s):
    with open(os.path.join(fd, "recorder.log"), "a") as f:
        f.write(s + "\n")

log(f"start {os.getpid()} {out}")
with open(os.path.join(fd, "recorder.env"), "w") as f:
    f.write("\n".join(sorted(os.environ.keys())))
if mode == "fail":
    print("fake recorder: no such audio device", file=sys.stderr)
    sys.exit(1)
if mode == "busy":
    print("fake recorder: device or resource busy", file=sys.stderr)
    sys.exit(1)

stop = False
def handler(signum, frame):
    global stop
    stop = True
    log(f"signal {signum}")
signal.signal(signal.SIGINT, handler)
signal.signal(signal.SIGTERM, handler)

begin = time.time()
while not stop:
    time.sleep(0.02)
    if mode == "die" and time.time() - begin > 0.8:
        print("fake recorder: stream error", file=sys.stderr)
        sys.exit(2)

if mode == "slowstop":
    sf = os.path.join(fd, "slowstop")
    time.sleep(float(open(sf).read()) if os.path.exists(sf) else 1.8)
rate = 16000
seconds = 0.0 if mode == "empty" else 1.0
frames = int(rate * seconds)
data = b"".join(struct.pack("<h", int(6000 * math.sin(2 * math.pi * 330 * i / rate))) for i in range(frames))
hdr = b"RIFF" + struct.pack("<I", 36 + len(data)) + b"WAVEfmt " + struct.pack("<IHHIIHH", 16, 1, 1, rate, rate * 2, 2, 16) + b"data" + struct.pack("<I", len(data))
with open(out, "wb") as f:
    f.write(hdr + data)
with open(os.path.join(fd, "last-recording.wav"), "wb") as f:
    f.write(hdr + data)
log("finished")
sys.exit(0)
