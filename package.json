{
  "name": "@jangmanj/pi-speech",
  "version": "0.3.2",
  "description": "Text-to-speech and speech-to-text for Pi: read replies aloud, dictate prompts (Alt+Z), transcribe audio. OpenRouter, xAI, OpenAI-compatible endpoints or local on-device models (Whisper, Parakeet, Kokoro), with playback on a remote machine over SSH",
  "license": "MIT",
  "author": "JangMan-J",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-speech.git"
  },
  "homepage": "https://github.com/JangMan-J/pi-speech#readme",
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-speech/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "speech",
    "voice",
    "text-to-speech",
    "tts",
    "read-aloud",
    "speech-to-text",
    "stt",
    "dictation",
    "voice-input",
    "transcription",
    "audio",
    "whisper",
    "kokoro",
    "openrouter",
    "xai"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src",
    "receivers.json",
    "receiver/src",
    "receiver/Cargo.toml",
    "receiver/Cargo.lock",
    "protocol",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/JangMan-J/pi-speech/main/assets/social-1280x640.png"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "init-package": "node scripts/init-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "~22.19.0",
    "typebox": "1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
